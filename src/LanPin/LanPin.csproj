<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
  <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion><UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><EnableMsixTooling>false</EnableMsixTooling>
  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
  <SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier><Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><AssemblyName>LanPin</AssemblyName><RootNamespace>LanPin.Desktop</RootNamespace><Version>0.4.0</Version>
  <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets\LanPin.ico</ApplicationIcon><DebugType>none</DebugType><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
 </PropertyGroup>
 <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003"/><PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654"/></ItemGroup>
 <ItemGroup><Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest"/><None Update="LICENSE;Licenses\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
 <Target Name="PublishWinUIResources" AfterTargets="ComputeFilesToPublish">
  <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI application PRI resources are missing."/>
  <ItemGroup><ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri"><RelativePath>$(AssemblyName).pri</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></ResolvedFileToPublish><ResolvedFileToPublish Include="$(TargetDir)App.xbf"><RelativePath>App.xbf</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></ResolvedFileToPublish></ItemGroup>
 </Target>
</Project>



