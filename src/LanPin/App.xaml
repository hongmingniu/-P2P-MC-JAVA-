<Application x:Class="LanPin.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
 <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>
 <Color x:Key="SystemAccentColor">#AF633E</Color><SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#AF633E"/>
 <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}"/></Style>
 <Style TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}"/><Setter Property="CornerRadius" Value="8"/></Style>
 <Style TargetType="TextBox"><Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}"/><Setter Property="CornerRadius" Value="8"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>

