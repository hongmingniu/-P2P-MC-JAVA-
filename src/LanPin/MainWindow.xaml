        <TextBlock x:Name="WallpaperName" Text="当前：默认渐变" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,18"/>
        <TextBlock Text="默认渐变" FontSize="12" Foreground="#645D56"/><WrapPanel Margin="0,10,0,21"><Button Content="暖雾" Tag="Forest" Click="PaletteClick" Padding="19,8" Margin="0,0,9,0"/><Button Content="暖沙" Tag="Dusk" Click="PaletteClick" Padding="19,8" Margin="0,0,9,0"/><Button Content="雾蓝" Tag="Slate" Click="PaletteClick" Padding="19,8"/></WrapPanel>
        <DockPanel><TextBlock Text="背景模糊" FontSize="13"/><TextBlock x:Name="BlurValue" Text="7" HorizontalAlignment="Right" Foreground="#845437"/></DockPanel><Slider x:Name="BlurSlider" Minimum="0" Maximum="24" Value="7" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AppearanceSliderChanged" Margin="0,10,0,17" AutomationProperties.Name="背景模糊"/>
        <DockPanel><TextBlock Text="磨砂遮罩" FontSize="13"/><TextBlock x:Name="ShadeValue" Text="45%" HorizontalAlignment="Right" Foreground="#845437"/></DockPanel><Slider x:Name="ShadeSlider" Minimum="0.2" Maximum="0.8" Value="0.45" ValueChanged="AppearanceSliderChanged" Margin="0,10,0,17" AutomationProperties.Name="磨砂遮罩"/>
        <DockPanel><TextBlock Text="面板不透明度" FontSize="13"/><TextBlock x:Name="PanelValue" Text="73%" HorizontalAlignment="Right" Foreground="#845437"/></DockPanel><Slider x:Name="PanelSlider" Minimum="0.4" Maximum="0.95" Value="0.73" ValueChanged="AppearanceSliderChanged" Margin="0,10,0,18" AutomationProperties.Name="面板不透明度"/>
