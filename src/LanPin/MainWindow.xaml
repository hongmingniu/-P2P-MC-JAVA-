<Window x:Class="LanPin.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="LanPin Next · Minecraft Java 联机" Icon="Assets/LanPin.ico" Width="1260" Height="860" MinWidth="1060" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#10251D" Foreground="{DynamicResource Ink}" FontFamily="pack://application:,,,/LanPin;component/Assets/#HarmonyOS Sans SC" FontSize="13" AllowDrop="True" DragOver="WindowDragOver" Drop="WindowDrop" Closing="WindowClosing" StateChanged="WindowStateChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="18" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border x:Name="WindowFrame" CornerRadius="18" BorderBrush="#4C9AB19F" BorderThickness="1">
  <Grid ClipToBounds="True">
   <Grid x:Name="DefaultBackdrop"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop x:Name="BaseA" Color="#213B32" Offset="0"/><GradientStop x:Name="BaseB" Color="#10251E" Offset="1"/></LinearGradientBrush></Grid.Background><Ellipse Width="850" Height="760" Margin="-360,-260,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#AA597E62"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse><Ellipse x:Name="WarmGlow" Width="700" Height="650" Margin="0,0,-280,-250" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#887E604E"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse></Grid>
   <Image x:Name="WallpaperImage" Stretch="UniformToFill" IsHitTestVisible="False"><Image.Effect><BlurEffect x:Name="WallpaperBlur" Radius="7"/></Image.Effect></Image>
   <Rectangle x:Name="ShadeLayer" Fill="#07150E" Opacity="0.45" IsHitTestVisible="False"/>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Grid Background="Transparent" MouseLeftButtonDown="TitleBarMouseDown" MouseRightButtonUp="TitleBarRightClick">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
      <Grid Width="29" Height="29" Margin="0,0,12,0"><Rectangle Width="19" Height="19" RadiusX="5" RadiusY="5" Stroke="#AFEAC3" StrokeThickness="1.7" HorizontalAlignment="Left" VerticalAlignment="Top"/><Rectangle Width="19" Height="19" RadiusX="5" RadiusY="5" Stroke="#DAF4DC" StrokeThickness="1.7" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
      <TextBlock Text="LanPin" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/><TextBlock Text="NEXT" FontSize="10" Foreground="#A8BEB0" VerticalAlignment="Center" Margin="12,3,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
      <TextBlock Text="v0.2.2 · 实验版" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0"/>
      <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" AutomationProperties.Name="最小化" ToolTip="最小化" Click="MinimizeClick"/>
      <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" AutomationProperties.Name="最大化或还原" ToolTip="最大化 / 还原" Click="MaximizeClick"/>
      <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" AutomationProperties.Name="关闭" ToolTip="关闭" Click="CloseClick" Margin="4,0,0,0"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="30,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal"><Button x:Name="ConnectTab" Style="{StaticResource NavButton}" Content="联机" Click="ConnectTabClick"/><Button x:Name="AppearanceTab" Style="{StaticResource NavButton}" Content="外观" Click="AppearanceTabClick"/><Button x:Name="GuideTab" Style="{StaticResource NavButton}" Content="指南" Click="GuideTabClick"/></StackPanel>
     <Border Grid.Column="1" Background="#1CE3F3DE" CornerRadius="18" Padding="13,5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="TopStatusDot" Width="6" Height="6" Fill="#95AB9B" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="TopStatusText" Text="未连接" FontSize="11" Foreground="#D0E1D1"/></StackPanel></Border>
    </Grid>
    <Grid x:Name="PageHost" Grid.Row="2" Margin="34,15,34,12" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
     <Grid x:Name="ConnectPage">
      <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="2,0,0,0"><TextBlock Text="世界很大，一起玩。" FontSize="34" FontWeight="Bold"/><TextBlock Text="用一组分享信息，连接朋友的 Minecraft Java 存档。" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.57*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,3,0"><StackPanel>
        <TextBlock Text="选择你的角色" FontSize="17" FontWeight="Bold"/>
        <Grid Margin="0,15,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="JoinerRoleButton" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Click="JoinerRoleClick"><Border x:Name="JoinerRoleBorder" CornerRadius="13" BorderThickness="1.2" BorderBrush="#A7DDB5" Background="#35487E56" Padding="17,15"><StackPanel><DockPanel><TextBlock Text="加入方" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="JoinerCheck" Text="✓" Foreground="#BBEBC9" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="我来加入朋友的世界" Style="{StaticResource Caption}" Margin="0,9,0,0" FontSize="11"/></StackPanel></Border></Button>
         <Button x:Name="AccessRoleButton" Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Click="AccessRoleClick"><Border x:Name="AccessRoleBorder" CornerRadius="13" BorderThickness="1.2" BorderBrush="#38C4DAC6" Background="#1225381F" Padding="17,15"><StackPanel><DockPanel><TextBlock Text="存档接入方" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="AccessCheck" Text="✓" Foreground="#BBEBC9" HorizontalAlignment="Right" Visibility="Hidden"/></DockPanel><TextBlock Text="接入本机或内网存档" Style="{StaticResource Caption}" Margin="0,9,0,0" FontSize="11"/></StackPanel></Border></Button>
        </Grid>
        <DockPanel Margin="0,0,0,7"><TextBlock Text="加入方 IPv6" FontSize="12" Foreground="#BED1C3"/><Button x:Name="DetectButton" DockPanel.Dock="Right" Content="自动检测" FontSize="11" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#B6D9BF" Click="DetectIpv6Click" HorizontalAlignment="Right"/></DockPanel>
        <TextBox x:Name="AddressBox" Tag="自动检测，也可手动填写" AutomationProperties.Name="加入方 IPv6 地址"/>
        <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="分享 PIN" FontSize="12" Foreground="#BED1C3" VerticalAlignment="Center"/><Button x:Name="CopyButton" Grid.Column="1" Content="复制分享信息" FontSize="11" Padding="0" Foreground="#B6D9BF" Background="Transparent" BorderThickness="0" Click="CopyShareClick" IsEnabled="False"/></Grid>
        <TextBox x:Name="PinBox" Tag="开始分享后生成一次性 PIN" IsReadOnly="True" FontSize="14" Margin="0,7,0,0" AutomationProperties.Name="分享 PIN"/>
        <TextBlock Text="本机网络" FontSize="12" Foreground="#BED1C3" Margin="0,14,0,7"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><ComboBox x:Name="NetworkChoice" AutomationProperties.Name="本机网络接口"/><Button x:Name="RefreshNetworkButton" Grid.Column="2" Content="↻" FontSize="19" Padding="0" Click="RefreshNetworkClick" ToolTip="刷新网卡" AutomationProperties.Name="刷新网卡"/></Grid>
        <Button x:Name="AdvancedToggle" Content="网络选项  +" HorizontalAlignment="Left" Foreground="#A7C2AF" Padding="0,9" FontSize="11" Background="Transparent" BorderThickness="0" Margin="0,3,0,0" Click="AdvancedClick"/>
        <Border x:Name="AdvancedHost" Height="0" Opacity="0" ClipToBounds="True"><Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="加入方 TCP 端口" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox x:Name="PortBox" Text="38443" AutomationProperties.Name="加入方 TCP 端口"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="手动游戏地址（接入方可选）" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox x:Name="ManualBox" IsEnabled="False" Tag="例如 127.0.0.1:5222" AutomationProperties.Name="手动游戏地址"/></StackPanel></Grid></Border>
       </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,8,0,0">
        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="生成分享信息  ↗" Style="{StaticResource PrimaryButton}" Click="StartClick"/><Button x:Name="StopButton" Content="停止" Grid.Column="1" Margin="10,0,0,0" Visibility="Collapsed" Click="StopClick"/></Grid>
        <TextBlock x:Name="RoleHelp" Style="{StaticResource Caption}" FontSize="11" Margin="0,12,0,0" Text="将 IPv6、端口和 PIN 私下发送给存档接入方。双方 IPv6 需互通。"/>
       </StackPanel></Grid></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="联机状态" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,15,0,0"><Border Width="44" Height="44" CornerRadius="14" Background="#25447B55" Margin="0,0,13,0"><TextBlock x:Name="StateGlyph" Text="⌁" Foreground="#B5E1BE" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StateTitle" Text="准备就绪" FontWeight="Bold" FontSize="20"/><TextBlock x:Name="StateHint" Text="选择角色，开始一次新的联机" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0"/></StackPanel></StackPanel></StackPanel>
        <StackPanel Grid.Row="1"><Border Height="1" Background="#22D6E9D9" Margin="0,23,0,20"/><DockPanel><TextBlock Text="最近发现的存档" FontWeight="Bold" FontSize="14"/><TextBlock x:Name="WorldCount" Text="0" FontSize="11" Foreground="#9FBAA7" HorizontalAlignment="Right"/></DockPanel></StackPanel>
        <Grid Grid.Row="2" Margin="0,16,0,12"><StackPanel x:Name="EmptyWorlds" VerticalAlignment="Center"><TextBlock Text="◇" FontSize="32" Foreground="#7EAC90" HorizontalAlignment="Center"/><TextBlock Text="世界，还在等你连接" FontSize="14" HorizontalAlignment="Center" Margin="0,13,0,7"/><TextBlock Text="配对后会自动发现局域网存档。&#x0a;在游戏列表中寻找〈LanPin〉前缀。" Style="{StaticResource Caption}" FontSize="11" TextAlignment="Center"/></StackPanel>
         <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="WorldList"><ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="12" Background="#264D7F54" BorderBrush="#274F735A" BorderThickness="1" Margin="0,0,0,9" Padding="13"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Endpoint}" Foreground="#BCD8C3" FontSize="11" Margin="0,7,0,5"/><Button Content="复制备用地址" Tag="{Binding Endpoint}" Click="CopyWorldClick" FontSize="10" Padding="0,4" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#A9DDB6"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
        <Border Grid.Row="3" CornerRadius="11" Background="#31132019" Padding="13"><StackPanel><TextBlock Text="最近动态" FontSize="11" Foreground="#9DB6A6"/><TextBlock x:Name="LastActivity" Text="分享信息仅用于当前会话，软件不会保存 PIN。" FontSize="11" Foreground="#C5D8CA" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0"/><Button Content="查看连接日志" FontSize="10" Foreground="#A1CBAE" Background="Transparent" BorderThickness="0" Padding="0,7,0,0" HorizontalAlignment="Left" Click="ShowLogsClick"/></StackPanel></Border>
       </Grid></Border>
      </Grid>
     </Grid>
     <Grid x:Name="AppearancePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="让这里，更像你。" FontSize="34" FontWeight="Bold"/><TextBlock Text="选一张喜欢的背景，调整到刚刚好的通透感。" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <CheckBox x:Name="GlassCheck" Content="桌面毛玻璃（透出后方窗口）" Checked="AppearanceCheckChanged" Unchecked="AppearanceCheckChanged" Margin="0,0,0,8"/>
        <TextBlock x:Name="MaterialStatus" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,16"/>
        <DockPanel><TextBlock Text="毛玻璃中的背景图混合" FontSize="13"/><TextBlock x:Name="BlendValue" HorizontalAlignment="Right" Foreground="#A9CBB4"/></DockPanel><Slider x:Name="BlendSlider" Minimum="0" Maximum="0.8" Value="0.22" ValueChanged="AppearanceSliderChanged" Margin="0,10,0,20" AutomationProperties.Name="毛玻璃中的背景图混合"/>
        <TextBlock Text="自定义背景" FontWeight="Bold" FontSize="17"/><TextBlock Text="PNG / JPG / BMP · 最大 24 MB，也可拖入图片" Style="{StaticResource Caption}" Margin="0,7,0,16"/>
        <WrapPanel><Button Content="选择本地图片" Click="BrowseWallpaperClick" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="恢复默认背景" Click="ResetBackgroundClick" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock x:Name="WallpaperName" Text="当前：默认渐变" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,18"/>
        <TextBlock Text="默认渐变" FontSize="12" Foreground="#C7DACA"/><WrapPanel Margin="0,10,0,21"><Button Content="森林" Tag="Forest" Click="PaletteClick" Padding="19,8" Margin="0,0,9,0"/><Button Content="暮色" Tag="Dusk" Click="PaletteClick" Padding="19,8" Margin="0,0,9,0"/><Button Content="雾蓝" Tag="Slate" Click="PaletteClick" Padding="19,8"/></WrapPanel>
        <DockPanel><TextBlock Text="背景模糊" FontSize="13"/><TextBlock x:Name="BlurValue" Text="7" HorizontalAlignment="Right" Foreground="#A9CBB4"/></DockPanel><Slider x:Name="BlurSlider" Minimum="0" Maximum="24" Value="7" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AppearanceSliderChanged" Margin="0,10,0,17" AutomationProperties.Name="背景模糊"/>
        <DockPanel><TextBlock Text="深色遮罩" FontSize="13"/><TextBlock x:Name="ShadeValue" Text="45%" HorizontalAlignment="Right" Foreground="#A9CBB4"/></DockPanel><Slider x:Name="ShadeSlider" Minimum="0.2" Maximum="0.8" Value="0.45" ValueChanged="AppearanceSliderChanged" Margin="0,10,0,17" AutomationProperties.Name="深色遮罩"/>
        <DockPanel><TextBlock Text="面板不透明度" FontSize="13"/><TextBlock x:Name="PanelValue" Text="73%" HorizontalAlignment="Right" Foreground="#A9CBB4"/></DockPanel><Slider x:Name="PanelSlider" Minimum="0.4" Maximum="0.95" Value="0.73" ValueChanged="AppearanceSliderChanged" Margin="0,10,0,18" AutomationProperties.Name="面板不透明度"/>
        <CheckBox x:Name="FitCheck" Content="完整显示图片（保留留白）" Checked="AppearanceCheckChanged" Unchecked="AppearanceCheckChanged" Margin="0,0,0,16"/><CheckBox x:Name="MotionCheck" Content="减少动效" Checked="AppearanceCheckChanged" Unchecked="AppearanceCheckChanged"/>
       </StackPanel></ScrollViewer></Border>
       <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="你的背景，由你掌控" FontWeight="Bold" FontSize="20"/><TextBlock Text="图片会复制到本机的 LanPin 数据目录。即使移动原图片，背景仍可继续使用。" Style="{StaticResource Caption}" Margin="0,14,0,0"/><Border Background="#3013261C" CornerRadius="12" Padding="18" Margin="0,22,0,0"><StackPanel><TextBlock Text="仅保存在本机" FontWeight="Bold"/><TextBlock Text="不上传背景，不修改原文件。&#x0a;外观设置不会保存 IP、PIN 或账号信息。" Style="{StaticResource Caption}" Margin="0,9,0,0"/></StackPanel></Border><TextBlock Text="桌面毛玻璃会模糊透出后方窗口；系统需开启透明效果。背景图混合越低，后方越明显。背景模糊仅调整导入的图片；文字保持清晰。" Style="{StaticResource Caption}" Margin="0,20,0,0"/></StackPanel></Border><TextBlock Text="本应用使用 HarmonyOS Sans 字体。&#x0a;Copyright 2021 Huawei Device Co., Ltd.&#x0a;字体许可随程序附在 Licenses 目录。" Style="{StaticResource Caption}" FontSize="11" Margin="5,20,0,0"/></StackPanel>
      </Grid>
     </Grid>
     <Grid x:Name="GuidePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="三步，连上朋友的世界。" FontSize="34" FontWeight="Bold"/><TextBlock Text="先分清角色，再分享连接信息。" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="01   加入方生成分享信息" FontSize="20" FontWeight="Bold"/><TextBlock Text="想加入游戏的人选择“加入方”，生成 IPv6、TCP 端口和 PIN，私下发送给存档接入方。" Style="{StaticResource Caption}" FontSize="14" Margin="0,12,0,28"/>
      <TextBlock Text="02   存档接入方连接" FontSize="20" FontWeight="Bold"/><TextBlock Text="在存档所在内网运行软件，选择“存档接入方”，填写加入方的信息。实际开服电脑可以是本机或内网另一台电脑。" Style="{StaticResource Caption}" FontSize="14" Margin="0,12,0,28"/>
      <TextBlock Text="03   对局域网开放，然后加入" FontSize="20" FontWeight="Bold"/><TextBlock Text="开服电脑在 Minecraft Java 中“对局域网开放”并保持运行。加入方在多人游戏中选择〈LanPin〉存档；列表不显示时，可复制软件中的备用地址直接连接。" Style="{StaticResource Caption}" FontSize="14" Margin="0,12,0,28"/>
      <Border Height="1" Background="#22D6E9D9" Margin="0,0,0,22"/><TextBlock Text="连接前检查" FontSize="16" FontWeight="Bold"/><TextBlock Text="双方 IPv6 需互通，加入方监听端口默认 38443，需允许存档接入方连接。Minecraft 游戏端口与该端口不同。&#x0a;双方游戏身份、版本和模组配置需兼容。此名称已被占用通常表示玩家身份重复。&#x0a;此版没有中继、自动重连或通用虚拟 IP；停止或网络变化后需重新配对。" Style="{StaticResource Caption}" FontSize="13" Margin="0,12,0,0"/>
      <Button Content="查看项目与下载说明  ↗" Click="OpenProjectClick" HorizontalAlignment="Left" Margin="0,24,0,0"/>
     </StackPanel></ScrollViewer></Border></Grid>
    </Grid>
    <Grid Grid.Row="3" Margin="36,0"><TextBlock Text="Minecraft Java · IPv6 P2P" FontSize="10" Foreground="#8BA796" VerticalAlignment="Center"/><TextBlock Text="HarmonyOS Sans  /  NEXT 0.2" HorizontalAlignment="Right" FontSize="10" Foreground="#789482" VerticalAlignment="Center"/></Grid>
   </Grid>
   <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30,0,30,48" Background="#F02A4935" BorderBrush="#759C7F" BorderThickness="1" CornerRadius="12" Padding="21,12"><TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="700" FontSize="13"/></Border>
   <Border x:Name="LogsOverlay" Background="#EB0D2017" Visibility="Collapsed" CornerRadius="18" Padding="30" Margin="48"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="连接日志" FontSize="24" FontWeight="Bold"/><Button Content="关闭" HorizontalAlignment="Right" Click="HideLogsClick"/></DockPanel><TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,20,0,16" FontSize="12"/><TextBlock Grid.Row="2" Text="日志不保存到磁盘；分享排错信息前，请检查其中的内网地址等个人信息。" Style="{StaticResource Caption}"/></Grid></Border>
  </Grid>
 </Border>
</Window>
