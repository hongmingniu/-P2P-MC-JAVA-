        <TextBlock x:Name="MaterialStatus" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,16"/>
        <DockPanel><TextBlock Text="毛玻璃中的背景图混合" FontSize="13"/><TextBlock x:Name="BlendValue" HorizontalAlignment="Right" Foreground="#845437"/></DockPanel><Slider x:Name="BlendSlider" Minimum="0" Maximum="0.8" Value="0.22" ValueChanged="AppearanceSliderChanged" Margin="0,10,0,20" AutomationProperties.Name="毛玻璃中的背景图混合"/>
